+}
+
+#mainMenu button.last { margin-top:35.4px; }
+
+/* Title Menu：游戏原版 T0201 第一格（288x40） */
+#titleMenuLabel {
+  position:absolute; left:310px; width:180px;
+  top:378.9px;
+  height:25px;
+  background-image:url("assets/ui/title_menu.png");
