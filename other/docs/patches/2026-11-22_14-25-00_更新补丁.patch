+
+echo   [2/3] 升级 pip ...
+"%PYEXE%" -m pip install --upgrade pip --disable-pip-version-check -q
+if errorlevel 1 echo   （pip 升级失败，先继续）
+
+echo   [3/3] 装依赖 Pillow / fonttools / pywebview（第一次要几分钟）...
