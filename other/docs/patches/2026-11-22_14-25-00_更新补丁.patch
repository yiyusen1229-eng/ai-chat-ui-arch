+%LAUNCH% -c "import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)" >nul 2>nul
+if errorlevel 1 goto oldpython
+
+echo   [1/3] 建虚拟环境 build_env\venv ...
+%LAUNCH% -m venv "%~dp0build_env\venv"
