+/* ================= 对话 ================= */
+#gameScreen { background:#000; }
+
+/* 场景背景：两层双缓冲，#bgLayer 常驻当前图、#bgLayer2 只在交叉淡化时淡入（见 wt-fade.js）。
+   过渡时长由 JS 给（200~300ms，设置里可关），所以这里不写 transition。
+   两层都带同一层渐隐蒙版：淡化中途两个蒙版叠起来的透明度约等于一层，画面不会中途变亮。 */
+#bgLayer, #bgLayer2 {
+  position:absolute; inset:0; background-size:cover; background-position:center;
+  opacity:0; transition:none;
+}
+#bgLayer { opacity:1; }
+#bgLayer::after, #bgLayer2::after { content:""; position:absolute; inset:0;
+  background:linear-gradient(to bottom, rgba(0,8,18,.05) 0%, rgba(0,0,0,0) 55%, rgba(0,6,14,.18) 100%); }
+
+#lightLayer { position:absolute; inset:0; pointer-events:none; }
+#snowLayer { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
+.flake { position:absolute; top:-12px; border-radius:50%;
+  background:rgba(230,250,255,.9); box-shadow:0 0 8px rgba(170,230,255,.9);
+  animation:fall linear infinite; }
+@keyframes fall {
+  0% { transform:translateY(-20px) translateX(0); opacity:0; }
+  8% { opacity:.85; } 92% { opacity:.4; }
+  100% { transform:translateY(468px) translateX(40px); opacity:0; }
+}
+
+#spriteWrap { position:absolute; left:50%; bottom:0; transform:translateX(-50%);
+  height:450px; display:flex; align-items:flex-end; pointer-events:none; }
+#sprite { height:450px; max-width:768px; object-fit:contain;
+  opacity:0; transform:translateY(16px); transition:opacity .6s, transform .6s; }
+#sprite.show { opacity:1; transform:translateY(0); }
+
+/* 交叉淡化用的叠层：和 #sprite 对齐，只负责淡入新图；淡完就把主图换掉、这层归零 */
+#spriteGhost { position:absolute; left:50%; bottom:0; transform:translateX(-50%);
+  height:450px; max-width:768px; object-fit:contain;
+  opacity:0; pointer-events:none; }
+
+/* ---------- 对话框 ----------
+   位置/尺寸是十几轮像素测量后的定稿值（历史见 git）。分三层：
+     #msgBox          只负责尺寸和事件，不画背景
+     #msgBox::before  填充层（渐变 + WHITE ALBUM 水印），screen 叠上去
+     #msgBox::after   丝带层，单独一层才能跟着 OPTION 的 UI 透明度一起淡 */
+#msgWrap {
+  position:absolute; left:50%; right:auto; bottom:0;
+  transform:translateX(-50%);
+  width:780px; height:130px;      /* 780 * 208/1248，和素材 1:1 */
+  padding:0; z-index:20;
+}
+
+#namePlate {
+  position:absolute; left:21.3%; top:5.2%;
+  font-size:11.5px; letter-spacing:1.3px; color:#ffffff;
+  text-shadow:0 0.5px 1.1px rgba(0,18,38,.95), 0 0 1.8px rgba(0,10,26,.5);
+  z-index:1;
+}
+
+#msgBox {
+  position:relative; height:100%;
+  background-image:none !important;        /* 丝带在 ::after，不在这里画 */
+  background-size:100% 100%, 100% 100% !important;
+  background-repeat:no-repeat, no-repeat !important;
+  background-position:0 0, 0 0 !important;
+  background-color:transparent !important;
+  background-blend-mode:screen !important;
+  filter:none !important;
+  opacity:1;
+  cursor:pointer;
+}
+#msgBox .fill { display:none !important; }
+#msgBox .walogo { display:none !important; }
+
+#msgBox::before {
+  content:"";
+  position:absolute; inset:0;
+  background:url("assets/ui/msgbox_fill.png") 0 0 / 100% 100% no-repeat !important;
+  mix-blend-mode:screen !important;
+  opacity:calc(.9 * var(--ui-alpha, 1)) !important;
+  pointer-events:none;
+  z-index:0;
+}
+#msgBox::after {
+  content:"";
+  position:absolute; left:0; top:0; right:0; bottom:0;
+  background:url("assets/ui/msgbox_ribbon.png") 0 0 / 100% 100% no-repeat;
+  opacity:var(--ui-alpha, 1);
+  pointer-events:none;
+  z-index:0;
+}
+
+#msgText {
+  position:relative;
+  left:23.5%; right:10%; top:30.5%;
+  font-size:15.5px; line-height:1.5; letter-spacing:0;
+  color:#ffffff;
+  -webkit-text-stroke:0.5px rgba(12,40,68,.95);
+  paint-order:stroke fill;
+  text-shadow:0 0.5px 1px rgba(0,10,24,.7);
+  white-space:pre-wrap; word-break:break-word;
+  z-index:1;
+}
+#msgText.gdi { -webkit-text-stroke:0; text-shadow:none; }
+#msgText.gdi img { image-rendering:auto; }
