@@ -0,0 +1,98 @@
+# -*- coding: utf-8 -*-
+"""场景图导入 / 匹配的自测（不转图、不花 token，纯临时目录）。
+
+钉住两条踩过的坑：
+  1. **增量导入不能冲掉旧目录**：以前 build_index 只按 --src 生成，
+     导第二批 63 张把原有 119 条的 index.json 写成只剩 63 条
+     （2026-11-21 实际发生，用 --rebuild 从 webp 文件名重建恢复）。
+  2. **素材里本来就有这个地点时不许被别名抢走**：新的「街道（白天）/（黑夜）」
+     和老的「街上」并存，按相似度打分「街上」会先撞线，
+     于是新整理的街道图全被老图盖掉。
+
+跑法（在 program/ 下）：
+    build_env/venv/Scripts/python.exe tools/test_import_cg.py
+"""
+import json
+import os
+import shutil
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(HERE, "src"))
+sys.path.insert(0, os.path.join(HERE, "tools"))
+
+import import_cg  # noqa: E402
+import scene_cg   # noqa: E402
+
+bad = 0
+
+
+def check(ok, msg):
+    global bad
+    if not ok:
+        bad += 1
+        print("  FAIL %s" % msg)
+    else:
+        print("  ok   %s" % msg)
+
+
+def touch(d, stem):
+    """build_index 只要求 webp 文件存在，内容不读"""
+    with open(os.path.join(d, stem + ".webp"), "wb") as f:
+        f.write(b"RIFF0000WEBP")
+
+
+def main():
+    tmp = tempfile.mkdtemp(prefix="wa2_cgtest_")
+    try:
+        dst = os.path.join(tmp, "cg")
+        os.makedirs(dst)
+        # 旧的一批
+        touch(dst, "咖啡厅（白天）")
+        touch(dst, "教室（夜晚）")
+        # 新导入的一批（只有一张和源目录同名）
+        touch(dst, "公司办公区（空无一人）（白天）")
+
+        print("[1] 增量导入保留旧目录")
+        index, items = import_cg.build_index(dst, ["公司办公区（空无一人）（白天）"], prune=False)
+        ids = {it["id"] for it in items}
+        check(len(items) == 3, "三条都在（%d）" % len(items))
+        check("咖啡厅（白天）" in ids, "旧的 咖啡厅（白天） 没被冲掉")
+        check("教室（夜晚）" in ids, "旧的 教室（夜晚） 没被冲掉")
+        check(os.path.isfile(index), "index.json 写出来了")
+
+        print("[2] --prune 时才只保留源目录")
+        _, items_pruned = import_cg.build_index(dst, ["公司办公区（空无一人）（白天）"], prune=True)
+        check(len(items_pruned) == 1, "prune 后只剩源目录里的那一条（%d）" % len(items_pruned))
+        # 恢复完整目录，给第 3 项用
+        import_cg.build_index(dst, [], prune=False)
+
+        print("[3] 素材里已有的地点不被别名抢走")
+        assets = os.path.join(tmp, "assets")
+        os.makedirs(os.path.join(assets, "cg"))
+        idx = {"version": 1, "generated": "", "items": [
+            {"id": "街上（晚上）（人行道）", "file": "街上（晚上）（人行道）.webp",
+             "place": "街上", "kind": "place", "time": "晚上", "weather": "", "state": ["人行道"]},
+            {"id": "街道（白天）", "file": "街道（白天）.webp",
+             "place": "街道", "kind": "place", "time": "白天", "weather": "", "state": []},
+            {"id": "街道（黑夜）", "file": "街道（黑夜）.webp",
+             "place": "街道", "kind": "place", "time": "黑夜", "weather": "", "state": []},
+        ]}
+        with open(os.path.join(assets, "cg", "index.json"), "w", encoding="utf-8") as f:
+            json.dump(idx, f, ensure_ascii=False)
+        scene_cg.set_assets_dir(assets)
+        scene_cg._CACHE["data"] = None      # 别让上一步的缓存串进来
+        m = scene_cg.match("街道（黑夜）") or {}
+        check(m.get("id") == "街道（黑夜）", "街道（黑夜）→ %r" % m.get("id"))
+        m2 = scene_cg.match("街上（晚上）") or {}
+        check(m2.get("place") == "街上", "街上（晚上）→ %r" % m2.get("place"))
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+
+    print("\n问题数: %d" % bad)
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/program/tools/test_run_dev.py b/program/tools/test_run_dev.py
new file mode 100644
index 0000000..0b5d2da
--- /dev/null
+++ b/program/tools/test_run_dev.py
@@ -0,0 +1,115 @@
+# -*- coding: utf-8 -*-
+"""开发入口的自测（不开窗口、不联网）。
+
+跑法：
+    cd program
+    build_env/venv/Scripts/python.exe tools/test_run_dev.py
+
+验的是「改完自动重来」这条链路里最容易错的部分：
+  1. _sig 只盯代码文件：素材、存档、缓存、立绘这些变了不该重启
+  2. _changed 能认出改动 / 新增 / 删除
+  3. 窗口被关掉时 watch 立刻退出（不会一直转下去）
+  4. _stop 能把子进程收干净（先 terminate，超时才 kill）
+"""
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+
+import run_dev as RD  # noqa: E402
+
+FAILS = []
+
+
+def check(name, cond, extra=""):
+    print(("  ok   " if cond else "  FAIL ") + name +
+          (("  " + str(extra)[:300]) if extra and not cond else ""))
+    if not cond:
+        FAILS.append(name)
+
+
+def write(path, text="x"):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+def main():
+    tmp = tempfile.mkdtemp(prefix="wa2_dev_")
+    fake_src = os.path.join(tmp, "src")
+    write(os.path.join(fake_src, "ui", "a.js"))
+    write(os.path.join(fake_src, "ui", "b.css"))
+    write(os.path.join(fake_src, "main.py"))
+    write(os.path.join(fake_src, "persona", "base.txt"))
+    # 这些都不该参与重启判断
+    write(os.path.join(fake_src, "ui", "cover.png"))
+    write(os.path.join(fake_src, "ui", "__pycache__", "x.py"))
+    write(os.path.join(fake_src, "characters", "和纱", "memory", "旧事.txt"))
+    write(os.path.join(fake_src, "sessions", "slot1.json"))
+    write(os.path.join(fake_src, "cache", "prices.json"))
+
+    real_src = RD.SRC
+    RD.SRC = fake_src
+    try:
+        print("[1] _sig 只盯代码")
+        sig = RD._sig()
+        keys = set(sig)
+        check("认 .js / .css / .py / .txt", {"ui/a.js", "ui/b.css", "main.py", "persona/base.txt"} <= keys,
+              sorted(keys))
+        check("不认图片", not any(k.endswith(".png") for k in keys), sorted(keys))
+        check("跳过 __pycache__", not any("__pycache__" in k for k in keys), sorted(keys))
+        check("跳过 characters（立绘/记忆变了几十次也别重启）",
+              not any(k.startswith("characters") for k in keys), sorted(keys))
+        check("跳过 sessions / cache",
+              not any(k.startswith(("sessions", "cache")) for k in keys), sorted(keys))
+
+        print("\n[2] _changed：改 / 增 / 删")
+        old = dict(sig)
+        t = time.time()
+        os.utime(os.path.join(fake_src, "ui", "a.js"), (t, t))
+        new = RD._sig()
+        check("改一个文件只报一个", RD._changed(old, new) == ["ui/a.js"], RD._changed(old, new))
+        write(os.path.join(fake_src, "ui", "c.js"))
+        new2 = RD._sig()
+        check("新增文件认得出", RD._changed(new, new2) == ["ui/c.js"], RD._changed(new, new2))
+        os.remove(os.path.join(fake_src, "ui", "c.js"))
+        new3 = RD._sig()
+        check("删除文件认得出", RD._changed(new2, new3) == ["ui/c.js"], RD._changed(new2, new3))
+        check("没变化就是空", RD._changed(new3, RD._sig()) == [], RD._changed(new3, RD._sig()))
+
+        print("\n[3] 窗口关了，watch 要自己退出")
+        class _Dead(object):
+            def poll(self):
+                return 0
+
+        t0 = time.time()
+        code = RD.watch(_Dead())
+        check("返回值 0", code == 0, code)
+        check("不等满一轮也该很快退出", time.time() - t0 < 5, round(time.time() - t0, 1))
+    finally:
+        RD.SRC = real_src
+
+    print("\n[4] _stop：先关再杀")
+    p = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(30)"])
+    t0 = time.time()
+    RD._stop(p, timeout=5)
+    cost = time.time() - t0
+    check("子进程真的没了", p.poll() is not None, p.poll())
+    check("没有硬等满超时", cost < 5, round(cost, 1))
+    RD._stop(None)
+    RD._stop(p)          # 已经死了再调一次也不该炸
+    check("重复调用安全", True)
+
+    print("\n" + ("全部通过" if not FAILS else "失败 %d 项：%s" % (len(FAILS), "、".join(FAILS))))
+    return 0 if not FAILS else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
