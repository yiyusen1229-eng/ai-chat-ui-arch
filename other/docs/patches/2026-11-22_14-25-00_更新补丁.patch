+def _stop(proc, timeout=8):
+    """先好好关，关不掉再强杀（窗口里可能还有没存的东西）"""
+    if not proc or proc.poll() is not None:
+        return
+    try:
+        proc.terminate()
+        for _ in range(int(timeout * 10)):
+            if proc.poll() is not None:
+                return
+            time.sleep(0.1)
+        proc.kill()
+    except Exception:
+        pass
+
