+html, body {
+  width:100%; height:100%; overflow:hidden;
+  background:#000;
+  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif;
+  -webkit-font-smoothing:none;
+  font-smooth:never;
+  color:#fff;
+  user-select:none;
+}
+
+/* 画面层：都铺在 #stage（800x450）里，靠 .active 淡入淡出 */
+.screen { position:absolute; inset:0; opacity:0; pointer-events:none; transition:opacity .5s; }
+.screen.active { opacity:1; pointer-events:auto; }
+
+
+/* ================= 800x450 舞台 ================= */
+#stage {
+  position:fixed; left:50%; top:50%;
+  width:800px; height:450px;
+  transform-origin:center center;
+  overflow:hidden;
+  background:#000;
+}
+
+/* ================= 开场动画 ================= */
+#introScreen { background:#000; cursor:pointer; }
+#introVideo {
+  position:absolute; inset:0;
+  width:100%; height:100%;
+  object-fit:cover;
+  background:#000;
+}
+#introHint {
+  position:absolute; right:26px; bottom:18px;
+  font-family: inherit !important; font-size:7.2px; letter-spacing:0.9px;
+  color:rgba(230,245,255,.55);
+  text-shadow:0 1px 3px rgba(0,0,0,.9);
+  animation:blink 2.4s infinite;
+}
+@keyframes blink { 0%,100%{opacity:.25;} 50%{opacity:.85;} }
+
+/* ================= 标题 ================= */
+#titleScreen { background:#000; }
+
+.title-bg {
+  position:absolute; inset:0;
+  background-image:url("assets/title.png");
+  background-size:cover;
+  background-position:center center;
+  background-repeat:no-repeat;
+}
+
+.title-logo {
+  position:absolute; left:50%; top:11.2%;
+  transform:translateX(-50%);
+  width:50%;
+  max-width:none;
+  pointer-events:none;
+  filter:drop-shadow(0 0 5.4px rgba(90,175,240,.45));
+}
+
+#mainMenu {
+  position:absolute; left:45.9%; top:49.4%;
+  display:flex; flex-direction:column; align-items:flex-start;
+  gap:1.3px; z-index:5;
+}
+
+#mainMenu button {
+  position:relative;
+  background:none; border:none; outline:none; cursor:pointer;
+  padding:0; line-height:0;
+  transition:transform .18s;
+}
+#mainMenu button img { display:block; width:75.2px; height:auto; }
+#mainMenu button .on { display:none; position:absolute; left:0; top:0; }
+#mainMenu button:hover .off { visibility:hidden; }
+#mainMenu button:hover .on { display:block; }
+#mainMenu button:hover { transform:translateX(1.8px); }
+
+/* 按钮底框：游戏原版 T0101（暗态常显，悬停变亮） */
+#mainMenu button::before {
+  content:"";
+  position:absolute; left:-62px; top:50%;
+  transform:translateY(-50%);
+  width:200px; height:17.5px;
+  background-image:url("assets/ui/menu_strip_off.png");
+  background-size:100% 100%;
+  background-repeat:no-repeat;
+  opacity:1;
+  z-index:-1;
+  transition:none;
+}
+#mainMenu button:hover::before {
