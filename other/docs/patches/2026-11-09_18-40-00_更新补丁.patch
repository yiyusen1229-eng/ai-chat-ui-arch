+++ b/program/src/cast.py
@@ -0,0 +1,137 @@
+# -*- coding: utf-8 -*-
+"""场次阵容：这一场有哪些人、谁是主角、谁是龙套。
+
+只做状态与校验，不生成内容（生成在 director.py 里，模型调用另接）。
+
+数据结构（内存，暂不落盘；存档要带 cast 时再序列化）：
+    {
+      "members": [
+          {"id": "和纱", "role": "protagonist"},   # 玩家扮演
+          {"id": "雪菜", "role": "actor"},         # 能被导演调度
+          {"name": "路人A", "role": "extra"}       # 龙套：导演现写，不进角色库
+      ],
+      "turns": 0
+    }
+"""
+import io
+import json
+import os
+
+import char_cards
+import characters as chars
+
+_state = {"members": [], "turns": 0}
+
+ROLE_NAMES = {"player": "玩家", "protagonist": "主角", "actor": "角色", "extra": "龙套"}
+
+
+def _char_dir(cid):
+    return os.path.join(chars.root(), cid) if cid else ""
+
+
+def _model_state(cid):
+    """读某个角色自己的模型配置（没有就返回未配置）"""
+    p = os.path.join(_char_dir(cid), "model.json")
+    out = {"chat": False, "voice": False, "model": ""}
+    if not cid or not os.path.isfile(p):
+        return out
+    try:
+        d = json.loads(io.open(p, encoding="utf-8").read()) or {}
+    except Exception:
+        return out
+    chat = d.get("chat") or {}
+    voice = d.get("voice") or {}
+    out["chat"] = bool(chat.get("connected"))
+    out["voice"] = bool(voice.get("connected") or voice.get("endpoint"))
+    out["model"] = chat.get("model") or ""
+    return out
+
+
+def _voice_ready(cid):
+    """有没有可用的音色素材（voice/ 下至少一个 wav）"""
+    d = os.path.join(_char_dir(cid), "voice")
+    if not os.path.isdir(d):
+        return False
+    for root, _dirs, files in os.walk(d):
+        for f in files:
+            if f.lower().endswith(".wav"):
+                return True
+    return False
+
+
+def get_cast():
+    return {"members": [dict(m) for m in _state["members"]], "turns": _state["turns"]}
+
+
+def set_cast(members):
+    """整表替换。只收合法条目，龙套不需要角色包。"""
+    clean = []
+    for m in (members or []):
+        if not isinstance(m, dict):
+            continue
+        role = m.get("role") or "actor"
+        if role not in ROLE_NAMES:
+            continue
+        if role == "player":
+            name = (m.get("name") or "你").strip() or "你"
+            clean.append({"name": name, "role": "player"})
+            continue
+        if role == "extra":
+            name = (m.get("name") or "").strip()
+            if name:
+                clean.append({"name": name, "role": "extra"})
+            continue
+        cid = (m.get("id") or "").strip()
+        if not cid or not os.path.isdir(_char_dir(cid)):
+            continue
+        clean.append({"id": cid, "role": role})
+    _state["members"] = clean
+    return {"ok": True, "cast": get_cast()}
+
+
+def clear():
+    _state["members"] = []
+    _state["turns"] = 0
+    return {"ok": True}
+
+
+def protagonist():
+    for m in _state["members"]:
+        if m.get("role") == "protagonist":
+            return m
+    return None
+
+
+def actors():
+    return [m for m in _state["members"] if m.get("role") in ("actor", "protagonist")]
+
+
+def status():
+    """给标题栏菜单用：每个成员的卡片/模型/语音状态"""
+    out = []
+    for m in _state["members"]:
+        if m.get("role") in ("extra", "player"):
+            if m.get("role") == "player":
+                out.append({"name": m.get("name"), "role": "player", "label": "玩家",
+                            "chat": True, "voice": False, "model": "", "has_card": False})
+                continue
+            out.append({"name": m.get("name"), "role": "extra", "label": ROLE_NAMES["extra"],
+                        "chat": False, "voice": False, "model": "", "has_card": False})
+            continue
+        cid = m.get("id")
+        ms = _model_state(cid)
+        ci = char_cards.info(cid)
+        out.append({
+            "id": cid, "name": ci["name"], "role": m.get("role"),
+            "label": ROLE_NAMES.get(m.get("role"), m.get("role")),
+            "chat": ms["chat"], "voice": ms["voice"] or _voice_ready(cid),
+            "model": ms["model"], "has_card": ci["has_director"]
+        })
+    return {
+        "members": out,
+        "turns": _state["turns"],
+        "protagonist": (protagonist() or {}).get("id", ""),
+        "can_join": [{"id": c["id"], "name": chars.display_name(c["id"]),
+                      "ok": char_cards.can_join_cast(c["id"])}
+                     for c in chars.list_characters()]
+    }
diff --git a/program/src/char_cards.py b/program/src/char_cards.py
new file mode 100644
index 0000000..d786032
--- /dev/null
+++ b/program/src/char_cards.py
@@ -0,0 +1,76 @@
+# -*- coding: utf-8 -*-
+"""角色卡：给导演看的卡 / 给角色自己看的卡 / 主角卡。
+
+多角色系统里，模型不是读"角色包"，而是读这三张卡：
+
+    characters/<id>/card/director.md    角色卡（给导演看的 150~300 字压缩卡）
+    characters/<id>/card/protagonist.md 主角卡：玩家扮演谁（临时放这里，将来进 player/）
+
+约定：
+  · director.md 缺失 → 这个角色不能进多角色场次（导演不知道该怎么调度它）；
+  · 文件名叫 director.md 只是因为它给导演用；对用户/文档一律叫「角色卡」。
+
+这里只负责读写与校验，不碰模型。
+"""
+import io
+import os
+
+import characters as chars
+
+KINDS = ("director", "protagonist")
+TITLES = {"director": "角色卡", "protagonist": "主角卡"}
+
+
+def card_dir(cid=None):
+    base = chars.active_dir() if cid is None else os.path.join(chars.root(), cid)
+    return os.path.join(base, "card") if base else ""
+
+
+def card_path(kind, cid=None):
+    if kind not in KINDS:
+        return ""
+    d = card_dir(cid)
+    return os.path.join(d, kind + ".md") if d else ""
+
+
+def read_card(kind, cid=None):
+    p = card_path(kind, cid)
+    if not p or not os.path.isfile(p):
+        return ""
+    try:
+        return io.open(p, encoding="utf-8").read()
+    except Exception:
+        return ""
+
+
+def write_card(kind, text, cid=None):
+    p = card_path(kind, cid)
+    if not p:
+        return {"ok": False, "error": "没有角色目录"}
+    try:
+        os.makedirs(os.path.dirname(p), exist_ok=True)
+        io.open(p, "w", encoding="utf-8", newline="").write(text or "")
+        return {"ok": True, "path": p}
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+
+
+def has_card(kind, cid=None):
+    p = card_path(kind, cid)
+    return bool(p and os.path.isfile(p) and os.path.getsize(p) > 0)
+
+
+def info(cid=None):
+    """给界面/场次用的卡片状态"""
+    return {
+        "id": cid or chars.active_id(),
+        "name": chars.display_name(cid),
+        "has_director": has_card("director", cid),
+        "has_protagonist": has_card("protagonist", cid),
+        "dir": card_dir(cid)
+    }
+
+
+def can_join_cast(cid=None):
+    """能不能进多角色场次：必须有导演卡"""
+    return has_card("director", cid)
