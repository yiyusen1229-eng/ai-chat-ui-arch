+#lightLayer { position:absolute; inset:0; pointer-events:none; }
+#snowLayer { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
+.flake { position:absolute; top:-12px; border-radius:50%;
+  background:rgba(230,250,255,.9); box-shadow:0 0 8px rgba(170,230,255,.9);
+  animation:fall linear infinite; }
+@keyframes fall {
+  0% { transform:translateY(-20px) translateX(0); opacity:0; }
+  8% { opacity:.85; } 92% { opacity:.4; }
+  100% { transform:translateY(468px) translateX(40px); opacity:0; }
+}
+
+#spriteWrap { position:absolute; left:50%; bottom:0; transform:translateX(-50%);
+  height:450px; display:flex; align-items:flex-end; pointer-events:none; }
+#sprite { height:450px; max-width:768px; object-fit:contain;
+  opacity:0; transform:translateY(16px); transition:opacity .6s, transform .6s; }
+#sprite.show { opacity:1; transform:translateY(0); }
