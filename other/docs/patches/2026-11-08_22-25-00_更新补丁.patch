+#bgLayer { opacity:1; }
+#bgLayer::after, #bgLayer2::after { content:""; position:absolute; inset:0;
+  background:linear-gradient(to bottom, rgba(0,8,18,.05) 0%, rgba(0,0,0,0) 55%, rgba(0,6,14,.18) 100%); }
