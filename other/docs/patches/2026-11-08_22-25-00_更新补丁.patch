+/* 交叉淡化用的叠层：和 #sprite 对齐，只负责淡入新图；淡完就把主图换掉、这层归零 */
+#spriteGhost { position:absolute; left:50%; bottom:0; transform:translateX(-50%);
+  height:450px; max-width:768px; object-fit:contain;
+  opacity:0; pointer-events:none; }
+
+/* ---------- 对话框 ----------
+   位置/尺寸是十几轮像素测量后的定稿值（历史见 git）。分三层：
+     #msgBox          只负责尺寸和事件，不画背景
+     #msgBox::before  填充层（渐变 + WHITE ALBUM 水印），screen 叠上去
+     #msgBox::after   丝带层，单独一层才能跟着 OPTION 的 UI 透明度一起淡 */
+#msgWrap {
+  position:absolute; left:50%; right:auto; bottom:0;
+  transform:translateX(-50%);
+  width:780px; height:130px;      /* 780 * 208/1248，和素材 1:1 */
+  padding:0; z-index:20;
+}
+
+#namePlate {
+  position:absolute; left:21.3%; top:5.2%;
+  font-size:11.5px; letter-spacing:1.3px; color:#ffffff;
+  text-shadow:0 0.5px 1.1px rgba(0,18,38,.95), 0 0 1.8px rgba(0,10,26,.5);
+  z-index:1;
+}
+
+#msgBox {
+  position:relative; height:100%;
+  background-image:none !important;        /* 丝带在 ::after，不在这里画 */
+  background-size:100% 100%, 100% 100% !important;
+  background-repeat:no-repeat, no-repeat !important;
+  background-position:0 0, 0 0 !important;
+  background-color:transparent !important;
+  background-blend-mode:screen !important;
+  filter:none !important;
+  opacity:1;
+  cursor:pointer;
+}
+#msgBox .fill { display:none !important; }
+#msgBox .walogo { display:none !important; }
+
+#msgBox::before {
+  content:"";
+  position:absolute; inset:0;
+  background:url("assets/ui/msgbox_fill.png") 0 0 / 100% 100% no-repeat !important;
+  mix-blend-mode:screen !important;
+  opacity:calc(.9 * var(--ui-alpha, 1)) !important;
+  pointer-events:none;
+  z-index:0;
+}
+#msgBox::after {
+  content:"";
+  position:absolute; left:0; top:0; right:0; bottom:0;
+  background:url("assets/ui/msgbox_ribbon.png") 0 0 / 100% 100% no-repeat;
+  opacity:var(--ui-alpha, 1);
+  pointer-events:none;
+  z-index:0;
+}
+
+#msgText {
+  position:relative;
+  left:23.5%; right:10%; top:30.5%;
+  font-size:15.5px; line-height:1.5; letter-spacing:0;
+  color:#ffffff;
+  -webkit-text-stroke:0.5px rgba(12,40,68,.95);
+  paint-order:stroke fill;
+  text-shadow:0 0.5px 1px rgba(0,10,24,.7);
+  white-space:pre-wrap; word-break:break-word;
+  z-index:1;
+}
+#msgText.gdi { -webkit-text-stroke:0; text-shadow:none; }
+#msgText.gdi img { image-rendering:auto; }
+
+/* ---------- 底部工具栏 ---------- */
+#toolbar {
+  position:absolute; right:5.4px; bottom:4.5px; height:19.8px;
+  /* 右边留 10px：原来提示条靠 margin-left:10px 占着这块，
+     现在提示条改成绝对定位不占布局了，用 padding 把同样的内缩补回来，
+     否则整排按钮会比发布版往右挪约 10px。 */
+  background:none;
+  display:flex; align-items:center; justify-content:flex-end; gap:6.8px;
+  padding:0 10px 0 0; z-index:26;
+  font-size:11px; color:rgba(220,245,255,.9);
+}
+#toolbar .tb {
+  width:18px; height:19.3px;
+  display:flex; align-items:center; justify-content:center;
+  background:none; border:none; cursor:pointer;
+  transition:transform .16s, filter .16s;
+}
+#toolbar .tb img {
+  max-width:100%; max-height:100%;
+  display:block; pointer-events:none;
+  filter:drop-shadow(0 0.7px 2px rgba(0,25,50,.8));
+}
+#toolbar .tb img.hv { display:none; }
+#toolbar .tb:hover img.nm { display:none; }
+#toolbar .tb:hover img.hv { display:block; }
+#toolbar .tb:hover { transform:translateY(-1.1px) scale(1.12); filter:brightness(1.25); }
+#toolbar .tb.txt {
+  font-size:8.5px; color:#dff4ff; letter-spacing:0;
+  text-shadow:0 0.7px 1.8px rgba(0,20,40,.85);
+}
+#toolbar .tb.close { filter:none; }
+/* 固定宽度 + 不接收鼠标：提示文字出现/消失都不能改变整排按钮的位置，
+   否则会触发「提示出现→按钮左移→鼠标离开→提示消失→按钮弹回」的高速抖动 */
+#toolbar .hint { position:absolute; right:0; bottom:100%; margin-bottom:2px;
+  letter-spacing:1px; opacity:.8; white-space:nowrap; pointer-events:none; }
+/* 自动续说开着：这个按钮常亮（用类而不是内联 filter，免得盖掉 hover 的亮度） */
+#toolbar .tb.is-on { filter:drop-shadow(0 0 6px rgba(120,220,255,.95)); }
+
+/* ---------- 底部输入栏（定稿：原图直用，挪到右下角） ---------- */
+#inputBar { position:absolute; left:512px; top:208px; bottom:auto;
+  width:280px; height:65px; display:flex; align-items:flex-start; gap:0;
+  z-index:25; opacity:1; transition:opacity .25s; }
+#inputFrame {
+  position:absolute; left:0; top:0; width:100%; height:100%;
+  pointer-events:none;
+  opacity:calc(.92 * var(--ui-alpha, 1)) !important;
+}
+#inputBar:hover, #inputBar:focus-within { opacity:1; }
+#input { flex:1; position:relative; background:none; border:none;
+  height:100%; padding:0 14px 0 26px; color:#eaf9ff;
+  font-family: inherit !important; font-size:11px; letter-spacing:0.5px; outline:none; }
+#input:focus { border-color:rgba(160,240,255,.95); }
+
+/* 思考 / 发送按钮：只留文字和定位，三态底板在 ::before 上（文件末尾） */
+#thinkBtn, #sendBtn {
+  position:absolute; bottom:-22px; height:20px;
+  width:82px; padding:0 9px; flex:0 0 auto;
+  font-size:7.6px;
+  color:#f4fcff !important;
+  font-family: inherit !important;
+  text-shadow:0 1px 2px rgba(0,18,36,.95) !important;
+  background-image:none !important;
+  background-size:100% 300% !important;
+  background-repeat:no-repeat !important;
+  background-position:0 0 !important;
+  background-color:transparent !important;
+  border:0 !important; border-radius:0 !important;
+  box-shadow:none !important; outline:0 !important;
+  appearance:none !important; -webkit-appearance:none !important;
+  cursor:pointer; isolation:isolate;
+}
+#thinkBtn { right:94px !important; margin:0 !important;
+  line-height:1 !important; white-space:nowrap; }
+#sendBtn { right:0 !important; margin-right:0; letter-spacing:1.3px; }
+
+.choice::before, .choice::after {
+  content:""; position:absolute; top:50%; width:34px; height:34px;
+  transform:translateY(-50%);
+  background-image:url("assets/snowflake_right.png");
+  background-size:contain; background-repeat:no-repeat;
+  opacity:.9;
+}
+.choice::before { left:16px; }
+.choice::after { right:16px; }
+.choice:hover { filter:brightness(1.3); transform:scale(1.02); }
+
+
+
+
+/* ---------- 设置面板 ---------- */
+#cfgPanel {
+  position:fixed; inset:0; z-index:60; display:none;
+  align-items:center; justify-content:center;
+  background:rgba(0,6,14,.72);
+}
+#cfgPanel.show { display:flex; }
+.cfgCard {
+  width:min(680px, 736px); max-height:387px; overflow-y:auto;
+  background:linear-gradient(180deg, rgba(8,36,60,.98), rgba(3,16,30,.99));
+  border:1px solid rgba(120,205,250,.4); border-radius:4px;
+  padding:26px 30px; box-shadow:0 20px 60px rgba(0,0,0,.6);
+}
+.cfgTitle { font-size:19px; letter-spacing:5px; color:#dff6ff; margin-bottom:18px; }
+.cfgSec { margin-bottom:18px; }
+.cfgLbl { font-size:12px; color:#7fd4ff; letter-spacing:2px; margin-bottom:8px; }
+.cfgRow { display:flex; align-items:center; gap:10px; margin:6px 0; font-size:14px; }
+.cfgRow span { width:56px; color:#bfe6ff; }
+.cfgRow select { flex:1; background:rgba(2,20,36,.9); color:#eaf9ff;
+  border:1px solid rgba(120,205,250,.4); border-radius:2px; padding:5px 8px;
+  font-family: inherit !important; font-size:13px; }
+.cfgRow input[type=range] { flex:1; accent-color:#4fc3ff; }
+.cfgRow b { width:44px; text-align:right; color:#9fe0ff; font-weight:400; font-size:12px; }
+.cfgRow button { background:rgba(20,90,140,.7); color:#eaf9ff; font-family: inherit !important;
+  border:1px solid rgba(120,205,250,.45); border-radius:2px; padding:5px 14px;
+  font-size:12px; cursor:pointer; }
+.cfgRow button:hover { background:rgba(40,140,200,.85); }
+.cfgBtns { display:flex; gap:12px; justify-content:flex-end; margin-top:20px; }
+.cfgBtns button { padding:8px 26px; background:linear-gradient(180deg, rgba(40,150,210,.9), rgba(10,70,120,.95));
+  border:1px solid rgba(150,230,255,.6); border-radius:2px; color:#fff;
+  font-family: inherit !important; font-size:14px; letter-spacing:2px; cursor:pointer; }
+
+/* ---------- 翻页提示：对话框文字末尾的页面图标 ----------
+   原版 page_02 的 120 帧精灵（tools/bake_page_cursor.py 烤成一条横向图）：
+   60fps、2 秒一轮。位置和缩放由 game.js 按文字图的格子算（每字 28×32）。 */
+#pageCursor {
+  position: absolute;
+  left: 0; top: 0;
+  width: 28px; height: 28px;
+  background-image: url("assets/ui/text/page_cursor.png");
+  background-repeat: no-repeat;
+  background-size: 3360px 28px;
+  transform-origin: top left;
+  display: none;
+  pointer-events: none;
+  z-index: 2;
+  animation: pageCursorRun 2s steps(120) infinite;
+}
+@keyframes pageCursorRun {
+  from { background-position: 0 0; }
+  to   { background-position: -3360px 0; }
+}
+
+
+/* ===== 思维文字: 左上区域, 不进对话框 ===== */
+#thinkBox {
+  position: absolute;
+  left: 3.2%;
+  top: 15%;
+  right: 9%;                  /* 和 left+width 同时存在时 right 不参与布局，保留只为宽度约束一致 */
+  width: 21%;
+  max-height: 34%;
+  overflow: hidden;
+  font-size: 10.5px;
+  line-height: 1.5;
+  color: #8fd0ef;
+  font-style: italic;
+  pointer-events: none;
+  text-shadow: 0 1px 3px rgba(0,10,24,.95), 0 0 6px rgba(0,20,40,.8);
+  opacity: .95;
+  word-break: break-all;
+  white-space: pre-wrap;
+  display: -webkit-box;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 7;      /* 最多 7 行, 超出显示省略号 */
+  z-index: 5;
+}
+#thinkBox.hidden { display: none !important; }
+
+
+
+
+
+/* ===================== 历史对话（按截图逐像素实测） ===================== */
+#historyPanel { position:absolute; inset:0; z-index:60; display:none; }
+#historyPanel.show { display:block; }
+/* 打开历史面板时收起其它 UI */
+body.histOpen #msgWrap,
+body.histOpen #inputBar,
+body.histOpen #toolbar { display:none !important; }
+
+/* 顶栏: 通栏，下沿 y=4.04%（游戏实测 62/1536） */
+#historyHead { position:absolute; left:0; right:0; top:0; height:auto; line-height:0; }
+#historyHead img { width:100%; height:auto; display:block; }
+
+/* 面板: x 14.25% ~ 83.15%, y 4.04% ~ 93.68% */
+#historyBox {
+  position:absolute; left:14.25%; right:16.85%; top:4.028%; bottom:6.250%;
+  background:url("assets/ui/history/panel.png") left top / 100% 100% no-repeat;
+}
+#historyBody { position:absolute; inset:0; }
+#historyList {
+  position:absolute; top:0; bottom:0; left:0; right:9.2%;   /* 右侧留出滑条宽度 */
+  overflow-y:auto; overflow-x:hidden;
+  padding: 4px 10px 6px 38.4px;
+  scrollbar-width:none; -ms-overflow-style:none;
+}
+#historyList::-webkit-scrollbar { width:0; height:0; }
+
+/* 记录 */
+.hline { display:flex; align-items:flex-start; margin:0 0 7px; }
+.hline .ico { flex:0 0 auto; width:16.1px; margin:3px 7.3px 0 0; line-height:0; cursor:default; }
+.hline .ico img { width:100%; display:block; }
+.hline .body { flex:1 1 auto; min-width:0; }
+.hline .who { display:block; font-size:18px; color:#eaf7ff; line-height:26px !important;
+  letter-spacing:.06em; margin-bottom:0;
+  text-shadow:0 1px 2px rgba(0,10,24,.95); }
+/* uitext 生成的图片默认 inline-block，会撑高行盒导致行距不齐，改成块级 */
+.hline .who img, .hline .txt img { display:block !important; }
+.hline .txt { font-size:18px; line-height:26px !important; text-indent:10.9px; color:#eaf7ff;
+  text-shadow:0 1px 2px rgba(0,10,24,.95); white-space:pre-wrap; }
+.hline.me .who { color:#ffd9e2; }
+.hline.me .txt { color:#f7ebf0; }
+
+/* 滑条: 在面板内部靠右，x 81.06%~82.60%，y 与面板同高 */
+#historyScroll { -webkit-app-region:no-drag;
+  /* 实测(模板匹配 0.98): x 80.88% 宽 2.01%; y 4.43%~93.36% */
+  position:absolute; left:80.88%; width:2.01%;
+  top:4.43%; bottom:6.64%;
+  display:flex; flex-direction:column; align-items:center;
+}
+.hsArrow { width:100%; padding:0; border:0; background:none; cursor:pointer; line-height:0; }
+.hsArrow img { width:100%; display:block; }
+.hsArrow .on { display:none; }
+.hsArrow:hover .off { display:none; }
+.hsArrow:hover .on { display:block; }
+
+#hsTrack { position:relative; flex:1 1 auto; width:100%; margin:1px 0; min-height:20px; }
+.hsTrackImg { width:100%; height:100%; display:block; }
+/* 滑块: 宽 52% 滑条宽、左缩进 24%，高度由 JS 按轨道比例设定 */
+#hsThumb { -webkit-app-region:no-drag; position:absolute; left:24%; width:52%; top:0; height:40px; cursor:grab; }
+#hsThumb img { width:100%; height:100%; display:block; }
+#hsThumb:active { cursor:grabbing; }
+
+/* 底栏: 上沿 y=93.68% */
+#historyFoot { position:absolute; left:0; right:0; bottom:0; height:auto; line-height:0; }
+#historyFoot img { width:100%; height:auto; display:block; }
+
+/* EXIT: 底栏右侧 */
+#historyExit {
+  position:absolute; right:2.4%; bottom:1.3%; height:3.2%;
+  padding:0; border:0; background:none; cursor:pointer; line-height:0;
+}
+#historyExit img { height:100%; width:auto; display:block; }
+#historyExit .on { display:none; }
+#historyExit:hover .off { display:none; }
+#historyExit:hover .on { display:block; }
+
+/* 对话界面底部蓝色微光条：素材 sys_00013.tga（1280x48）
+   alpha 自 0 递增到 175，贴在画面最下沿形成渐亮 */
+#glowBottom {
+  position: absolute;
+  left: 0;
+  bottom: 0;
+  width: 800px;
+  height: 30px;
+  z-index: 20;
+  pointer-events: none;
+}
+#glowBottom img { width: 100%; height: 100%; display: block; }
+
+/* 长句折行容器：每行一个 .txt */
+.hline .txtwrap { min-width:0; }
+
+/* 回想：悬停/重播时整句变黄。滤镜参数是解出来的：
+   我们的字芯 RGB(228,228,228) 经过 sepia(1) saturate(1.73) brightness(.98)
+   正好变成 RGB(250,250,164)，即游戏原图里黄字字芯色 #FAF6A4 */
+.hline.hl .who img, .hline.hl .txt img {
+  filter: sepia(1) saturate(2.05) brightness(1);
+}
+/* 对话界面按钮里的字模：按各自 CSS 字号换算高度 */
+#thinkBtn img, #sendBtn img { height: 8.5px !important; width: auto !important; display: inline-block; vertical-align: middle; }
+
+/* 动作按钮：标签图 + 值图，按 7.6px 字号换算 */
+#thinkBtn img.lbl { height: 8.5px !important; width: auto !important; vertical-align: middle; }
+#thinkBtn img.val { height: 8.5px !important; width: auto !important; vertical-align: middle; margin-left: 1px; }
+
+/* ===== OPTION 1「窗口透明度（普通场景）」=====
+   只淡 UI 底图，字模（正文 / 名字 / 占位符 / 按钮标签）一点不动。
+   数值由 game.js 的 __applyUiPrefs() 写进 :root 的 --ui-alpha（0~1）。
+
+   对话框的 UI 是两层：丝带层在 #msgBox::after，填充层在 #msgBox::before，
+   两层的 opacity 都乘上了 --ui-alpha（见文件前部）。
+   发送 / 动作按钮的底板也挪到 ::before，跟着一起淡。 */
+#thinkBtn::before, #sendBtn::before {
+  content: "";
+  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
+  z-index: -1;
+  background-image: url("assets/ui/btn_3state.png");
+  background-size: 100% 300%;
+  background-repeat: no-repeat;
+  background-position: 0 0;
+  opacity: var(--ui-alpha, 1);
+  pointer-events: none;
+}
+#thinkBtn:active::before, #sendBtn:active::before { background-position: 0 50%; }
+#thinkBtn.released::before, #sendBtn.released::before { background-position: 0 100%; }
+
+/* ===== 右下角：本条 / 累计 token 与花费 =====
+   文案和数字都是烤好的字模（tools/bake_cost_ui.py），前端只拼图，不再请求 /api/text
+   位置：发送按钮下方偏右（用户指定） */
+#costBar {
+  position: absolute;
+  right: 72px;
+  bottom: 101px;
+  z-index: 24;
+  pointer-events: none;
+  opacity: .95;
+}
+#costBar .row {
+  display: flex;
+  justify-content: flex-end;
+  align-items: center;
+  height: 12px;
+  margin-top: 2px;
+  gap: 3px;
+}
+#costBar .row img { height: 12px; width: auto; display: block; }
+#costBar .num { display: inline-flex; align-items: center; margin: 0 1px; }
+#costBar .row img.lb { margin: 0 .5px; }
+#costBar .num img { height: 12px; width: auto; display: block; margin: 0 .4px; }
+
+/* ===== 切角色过渡：整幕压黑 =====
+   层级：.uiScreen 是 120，这里 200，标题栏 2147483000 —— 只盖舞台，不盖窗口按钮。
+   流程见 sp-char.js：压黑 180ms → 换人 → 淡回 200ms；慢的时候中间显示角色名。 */
+#charFade {
+  position: absolute; inset: 0;
+  background: #000;
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity .18s ease;
+  z-index: 200;
+}
+#charFade.on {
+  opacity: 1;
+  pointer-events: auto;      /* 过渡期间挡住点击，别在换人的时候发消息 */
+}
+#charFadeName {
+  position: absolute; left: 0; right: 0; top: 50%;
+  transform: translateY(-50%);
+  text-align: center;
+  font-size: 14px;
+  color: #dff6ff;
+  opacity: 0;
+  transition: opacity .15s ease;
+  text-shadow: 0 1px 4px rgba(0,0,0,.9);
+}
+#charFade.slow #charFadeName { opacity: 1; }
+#charFadeName img { height: 14px; width: auto; display: block; margin: 0 auto; }
+
+/* ---------- 左下角：自动模式指示 ----------
+   小白条一直显示（原版 AUTO 行的左侧图标），绿色 ▶ 只在自动续说开着时显示。 */
+#autoHud {
+  position: absolute; left: 14px; bottom: 8px;
+  display: flex; align-items: flex-end; gap: 5px;
+  pointer-events: none; z-index: 27;
+}
+#autoHud img { display: block; }
+#autoBar  { width: 13px; height: auto; opacity: .92; }
+/* 注意选择器要比 #autoHud img 更具体，否则 display:none 会被它盖掉 */
+#autoHud #autoIcon { width: 15px; height: auto; display: none; }
+body.autoOn #autoHud #autoIcon { display: block; }
+/* ON 用原素材（16×10），跟着绿色 ▶ 一起显隐；按比例缩到 10px 宽 */
+#autoHud #autoOnLabel { display: none; width: 10px; height: auto; margin-left: 2px; }
+body.autoOn #autoHud #autoOnLabel { display: block; }
